# Writes ${OUTPUT} with the commit of the source tree (plan Pre-0: the build commit goes into the summary).
# Run at build time (add_custom_target) so that the header follows every commit without reconfiguring.
# Variables: SOURCE_DIR, OUTPUT, VERSION (the project version; optional)
find_package(Git QUIET)
if(NOT DEFINED VERSION)
  set(VERSION "")
endif()
set(CUADMM_PROJECT_STRING "cuADMM")
if(NOT VERSION STREQUAL "")
  set(CUADMM_PROJECT_STRING "cuADMM ${VERSION}")
endif()
set(CUADMM_GIT_COMMIT "unknown")
set(CUADMM_GIT_DIRTY "false")
if(GIT_EXECUTABLE)
  execute_process(COMMAND ${GIT_EXECUTABLE} -C "${SOURCE_DIR}" rev-parse HEAD
                  OUTPUT_VARIABLE commit OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE rc)
  if(rc EQUAL 0)
    set(CUADMM_GIT_COMMIT "${commit}")
    execute_process(COMMAND ${GIT_EXECUTABLE} -C "${SOURCE_DIR}" status --porcelain --untracked-files=no -- .
                    OUTPUT_VARIABLE status OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(NOT status STREQUAL "")
      set(CUADMM_GIT_DIRTY "true")
    endif()
  endif()
endif()
set(content "// generated by cmake/GitVersion.cmake at build time; do not edit
#ifndef CUADMM_VERSION_H
#define CUADMM_VERSION_H
#define CUADMM_BUILD_COMMIT \"${CUADMM_GIT_COMMIT}\"
#define CUADMM_BUILD_DIRTY ${CUADMM_GIT_DIRTY}
#define CUADMM_BUILD_PROJECT \"${CUADMM_PROJECT_STRING}\"
#define CUADMM_VERSION_STRING \"${VERSION}\"
#endif
")
if(EXISTS "${OUTPUT}")
  file(READ "${OUTPUT}" old)
else()
  set(old "")
endif()
if(NOT old STREQUAL content)
  file(WRITE "${OUTPUT}" "${content}")
endif()
